DECLARE 
v_empno emp.empno%type;
 v_deptno emp.deptno%type;
 v_message varchar2(20);
 
  BEGIN 
  v_empno:=&empno;
   SELECT deptno INTO v_deptno
   FROM emp
   WHERE empno=v_empno;
   
   IF v_deptno=10 THEN 
   v_message:='HEAD OFFICE';
    ELSE 
	v_message:='BRANCH OFFICE';
	END IF ;
	dbms_output.put_line('THSI IS'||'  '||v_message);
	END ;
	/
   