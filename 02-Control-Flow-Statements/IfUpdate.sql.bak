DECLARE 
v_empno emp.empno%type;
v_comm emp.comm%type;
v_newcomm emp.comm%type;
BEGIN 
v_empno:=&empno;
v_newcomm:=&newcomm;

 SELECT comm INTO v_comm
 FROM emp
 WHERE empno=v_empno;
  IF v_comm IS NULL THEN
 UPDATE emp SET comm=v_newcomm
 WHERE empno=v_empno;
 commit;
 dbms_output.put_line('commission update.....');
 ELSE
 dbms_output.put_line('commission already exists...');
 END IF ;
 end;
 /